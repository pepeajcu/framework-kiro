# Plantilla de variables de entorno.
#
# NO edites este archivo para configurar tu proyecto: ./setup.sh genera un .env
# con secretos aleatorios. Este archivo documenta qué variables existen y sirve
# de referencia al configurar el panel de despliegue.
#
# REGLA DE FORMATO: los comentarios van SIEMPRE en su propia línea, nunca detrás
# de un valor. Docker Compose no los separa del valor, así que
# `GTM_ID=   # GTM-XXX` acaba valiendo literalmente "# GTM-XXX".

# --- Aplicación ---
APP_NAME="Mi Proyecto"

# local | staging | production
ENVIRONMENT=local

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# URL absoluta. Se usa en correos y en sitemap.xml, donde no hay una petición
# entrante de la que deducir el host.
BASE_URL=http://localhost:8000

# --- Seguridad ---
# Genera uno con: openssl rand -hex 32
# Firma cookies de sesión y tokens de un solo uso. Rotarlo cierra todas las
# sesiones e invalida los enlaces de recuperación de contraseña.
SECRET_KEY=cambiame-por-un-valor-aleatorio-de-al-menos-32-caracteres

# --- Autenticación ---
# Duración de la cookie de sesión.
SESSION_LIFETIME_DAYS=14

# Vida del enlace de recuperación de contraseña.
PASSWORD_RESET_TTL_MINUTES=30

# Longitud mínima de contraseña. Es la única regla: las de composición
# ("una mayúscula, un símbolo") llevan a 'Password1!' y ya no las recomienda
# el NIST — una frase larga es más fuerte y más fácil de recordar.
PASSWORD_MIN_LENGTH=12

# false = /register no existe y las cuentas las crea un administrador.
ALLOW_REGISTRATION=true

# El primer administrador, creado por 'make seed'. Si la cuenta ya existe, el
# seed NO le cambia la contraseña.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Límites de intentos ---
# Se cuentan por IP y por cuenta a la vez: ninguna de las dos por separado
# frena a quien rota IPs o rota cuentas.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# Cada petición de recuperación manda un correo, así que el límite es más
# estrecho: sin él, el formulario sirve para inundar el buzón de otra persona.
PASSWORD_RESET_MAX_REQUESTS=5
PASSWORD_RESET_WINDOW_MINUTES=60

# --- Base de datos ---
POSTGRES_USER=kiro
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=kiro

# Puertos del HOST. Dentro de la red de compose los servicios siempre usan sus
# puertos internos (5432, 8000); esto solo controla por dónde se exponen fuera.
# setup.sh elige el primer puerto libre, no el canónico.
POSTGRES_PORT=5432
APP_PORT=8000

# Desde el host (migraciones, tests): localhost.
# Desde el contenedor de la app: compose sobreescribe el host por 'db'.
DATABASE_URL=postgresql+psycopg://kiro:cambiame@localhost:5432/kiro

# --- Correo transaccional ---
# console = imprime los correos en stdout. Es el valor seguro en desarrollo:
# nunca sale un correo real de tu máquina.
# console | resend | smtp
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME="Mi Proyecto"

# Solo si EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Solo si EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Analítica y SEO ---
# Cada variable vacía desactiva su integración: si no hay ID, no se renderiza
# ni una línea de script. Nada que limpiar cuando un proyecto no usa analítica.

# GTM-XXXXXXX
GTM_ID=

# G-XXXXXXXXXX
GA4_MEASUREMENT_ID=

# Necesario para el Measurement Protocol server-side
GA4_API_SECRET=

META_PIXEL_ID=

# Necesario para la Conversions API server-side
META_CAPI_TOKEN=

# Contenido del meta tag de verificación de Search Console
GSC_VERIFICATION=
